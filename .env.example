# Kopie als .env neben compose.yml. Keine Geheimnisse noetig: das Servergeheimnis
# (ETag-HMAC, CSRF) erzeugt der Server selbst in /data/server.secret.

# Reverse Proxy, dessen CF-Connecting-IP / X-Forwarded-For fuer die Client-API gilt (TrueNAS-Traefik).
DP_API_TRUSTED_PROXIES=10.0.30.20
# Gemeinsames Token zwischen Oberflaeche (web) und interner Admin-API (server:8141).
# Erzeugen: openssl rand -base64 36 | tr -d '=+/'
DP_ADMIN_API_TOKEN=

# Admin-Oberflaeche (web): Hostname und Proxys, deren Authentik-Header gelten (Pi-Traefik dns-prod-2).
# dns-prod-2 erreicht die .3 ueber eth0.20 (Routing-Metrik), Quelle ist daher 10.0.20.162, nicht 10.0.30.5.
ADMIN_HOSTS=driverpilot.dns-prod-2.local.cstrube.de
ADMIN_TRUSTED_PROXIES=10.0.30.5,10.0.20.162
ADMIN_GROUP=Homelab-Admins

# Basis der Einladungslinks und Serveradresse fuer die Clients.
DP_PUBLIC_BASE_URL=https://driverpilot.cstrube.de
# Release-Dateien fuer /downloads/ (im Container; compose mountet ./downloads read-only dorthin).
DP_DOWNLOADS_DIR=/downloads
# Release-Sync: GitHub-Webhook (Ereignis release) und/oder POST /hooks/sync-release laden neue
# Release-Dateien automatisch. Token = fine-grained PAT mit "Contents: Read-only" auf dem Client-Repo.
DP_CLIENT_REPO=Madchristian/DriverPilot
DP_GITHUB_TOKEN=
DP_GITHUB_WEBHOOK_SECRET=
DP_RELEASE_SYNC_TOKEN=
DP_RELEASES_KEEP=2
# Abgleich mit dem neuesten stabilen Release alle N Minuten (verpasster Webhook); 0 = aus.
DP_RELEASE_RECONCILE_MINUTES=360

# Datenschutzhinweis: Version muss sich bei jeder Textaenderung aendern (Clients muessen neu zustimmen).
DP_PRIVACY_NOTICE_VERSION=2026-10-01.2
DP_PRIVACY_NOTICE_FILE=/app/privacy_notice.txt

# Modelladapter: none = rein manuell, test = synthetisch (nur Tests!), codex = ChatGPT ueber Codex-OAuth
# (Login in der Adminansicht unter "KI (ChatGPT)"; ohne Login verhaelt sich der Server wie none).
DP_AI_PROVIDER=codex
DP_CODEX_MODEL=gpt-5.6-sol
#DP_CODEX_REASONING=medium
DP_AI_DAILY_CALLS=10
# gpt-5.6-sol braucht fuer einen vollstaendigen Bericht deutlich ueber 90 s (gemessen 01.10.26)
DP_AI_TIMEOUT_SECONDS=300

# Limits (rules.json-Defaults; nur verschaerfen).
#DP_MAX_NEW_CASES_PER_CLIENT_PER_DAY=5
#DP_MAX_NEW_CASES_GLOBAL_PER_DAY=30
#DP_MAX_OPEN_CASES_GLOBAL=100
#DP_CLIENT_REQUESTS_PER_MINUTE=30
