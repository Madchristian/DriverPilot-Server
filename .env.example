# Kopie als .env neben compose.yml. Keine Geheimnisse noetig: das Servergeheimnis
# (ETag-HMAC, CSRF) erzeugt der Server selbst in /data/server.secret.

# Reverse Proxy, dessen CF-Connecting-IP / X-Forwarded-For fuer die Client-API gilt (TrueNAS-Traefik).
DP_API_TRUSTED_PROXIES=10.0.30.20
# Reverse Proxy, dessen Authentik-Header fuer die Adminansicht gelten (Pi-Traefik dns-prod-2).
# dns-prod-2 erreicht die .3 ueber eth0.20 (Routing-Metrik), Quelle ist daher 10.0.20.162, nicht 10.0.30.5.
DP_ADMIN_TRUSTED_PROXIES=10.0.30.5,10.0.20.162
DP_ADMIN_GROUP=Homelab-Admins

# Wird in der Adminansicht zusammen mit dem Einladungscode angezeigt.
DP_PUBLIC_BASE_URL=https://driverpilot.cstrube.de

# Datenschutzhinweis: Version muss sich bei jeder Textaenderung aendern (Clients muessen neu zustimmen).
DP_PRIVACY_NOTICE_VERSION=2026-10-01.2
DP_PRIVACY_NOTICE_FILE=/app/privacy_notice.txt

# Modelladapter: none = rein manuell, test = synthetisch (nur Tests!), codex = ChatGPT ueber Codex-OAuth
# (Login in der Adminansicht unter "KI (ChatGPT)"; ohne Login verhaelt sich der Server wie none).
DP_AI_PROVIDER=codex
DP_CODEX_MODEL=gpt-5.6-sol
#DP_CODEX_REASONING=medium
DP_AI_DAILY_CALLS=10
DP_AI_TIMEOUT_SECONDS=90

# Limits (rules.json-Defaults; nur verschaerfen).
#DP_MAX_NEW_CASES_PER_CLIENT_PER_DAY=5
#DP_MAX_NEW_CASES_GLOBAL_PER_DAY=30
#DP_MAX_OPEN_CASES_GLOBAL=100
#DP_CLIENT_REQUESTS_PER_MINUTE=30
